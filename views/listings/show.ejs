<% layout("/layouts/boilerplate") %>

<!-- ==================== LEAFLET CSS ==================== -->

<link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<div class="text-center pb-5">

```
<h3>Listing Details:</h3>

<!-- ==================== LISTING ==================== -->

<div class="row">
    <div class="col-6 mx-auto">

        <div class="card">

            <img
                src="<%= listing.image.url %>"
                class="card-img-top show-img"
                alt="listing_image"
            >

            <div class="card-body">

                <p class="card-text">
                    <%= listing.title %>
                </p>

            </div>

        </div>

    </div>
</div>


<!-- ==================== LISTING INFORMATION ==================== -->

<ul class="d-inline-block text-start mt-3">

    <li>
        <%= listing.title %>
    </li>

    <li>
        <%= listing.description %>
    </li>

    <li>
        ₹ <%= listing.price.toLocaleString("en-IN") %>
    </li>

    <li>
        <%= listing.location %>
    </li>

    <li>
        <%= listing.country %>
    </li>

</ul>


<!-- ==================== MAP ==================== -->

<div class="row mt-4 mb-5">

    <div class="col-10 mx-auto">

        <h4 class="mb-3">
            Where you'll be
        </h4>

        <div id="map"></div>

    </div>

</div>


<!-- ==================== EDIT & DELETE ==================== -->

<div class="mb-5">

    <a
        href="/listings/<%= listing._id %>/edit"
        class="btn btn-danger"
    >
        Edit this Listing
    </a>

    <form
        method="POST"
        action="/listings/<%= listing._id %>?_method=DELETE"
        class="d-inline"
    >

        <button
            type="submit"
            class="btn btn-dark"
        >
            Delete this listing
        </button>

    </form>

</div>


<!-- ==================== LEAVE A REVIEW ==================== -->

<div class="row mt-5">

    <div class="col-8 mx-auto">

        <h4 class="mb-4">
            Leave a Review
        </h4>

        <form
            action="/listings/<%= listing._id %>/reviews"
            method="POST"
            novalidate
            class="needs-validation"
        >

            <!-- ==================== STAR RATING ==================== -->

            <div class="mb-3 text-start">

                <label class="form-label">
                    Rating
                </label>

                <div class="star-rating">

                    <input
                        type="radio"
                        id="star5"
                        name="review[rating]"
                        value="5"
                        required
                    >
                    <label for="star5">★</label>

                    <input
                        type="radio"
                        id="star4"
                        name="review[rating]"
                        value="4"
                    >
                    <label for="star4">★</label>

                    <input
                        type="radio"
                        id="star3"
                        name="review[rating]"
                        value="3"
                    >
                    <label for="star3">★</label>

                    <input
                        type="radio"
                        id="star2"
                        name="review[rating]"
                        value="2"
                    >
                    <label for="star2">★</label>

                    <input
                        type="radio"
                        id="star1"
                        name="review[rating]"
                        value="1"
                    >
                    <label for="star1">★</label>

                </div>

                <div class="invalid-feedback">
                    Please select a rating.
                </div>

            </div>


            <!-- ==================== COMMENT ==================== -->

            <div class="mb-3 text-start">

                <label
                    for="comment"
                    class="form-label"
                >
                    Comments
                </label>

                <textarea
                    name="review[comment]"
                    id="comment"
                    rows="5"
                    class="form-control"
                    placeholder="Write your review..."
                    required
                ></textarea>

                <div class="valid-feedback">
                    Looks good!
                </div>

                <div class="invalid-feedback">
                    Please write a comment.
                </div>

            </div>


            <!-- ==================== SUBMIT ==================== -->

            <button
                type="submit"
                class="btn btn-dark"
            >
                Submit
            </button>

        </form>

    </div>

</div>


<!-- ==================== ALL REVIEWS ==================== -->

<div class="row mt-5">

    <div class="col-10 mx-auto">

        <h4 class="mb-4">
            All Reviews
        </h4>

        <div class="row">

            <% for(let review of listing.reviews) { %>

                <div class="col-md-6 mb-4">

                    <div class="card shadow-sm h-100">

                        <div class="card-body text-start">

                            <h5 class="card-title">
                                Guest Review
                            </h5>


                            <!-- ==================== RATING ==================== -->

                            <p class="card-text mb-2">

                                <strong>
                                    Rating:
                                </strong>

                                <span class="text-warning">
                                    <%= "★".repeat(review.rating) %>
                                </span>

                                <span class="text-muted">
                                    (<%= review.rating %>/5)
                                </span>

                            </p>


                            <!-- ==================== COMMENT ==================== -->

                            <p class="card-text">

                                <strong>
                                    Comment:
                                </strong>

                                <br>

                                <%= review.comment %>

                            </p>


                            <!-- ==================== DELETE REVIEW ==================== -->

                            <form
                                method="POST"
                                action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                            >

                                <button
                                    type="submit"
                                    class="btn btn-sm btn-danger"
                                >
                                    Delete Review
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            <% } %>

        </div>

    </div>

</div>
```

</div>

<!-- ==================== LEAFLET JS ==================== -->

<script
    src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js">
</script>

<!-- ==================== MAP SCRIPT ==================== -->

<script>

    // Listing location from MongoDB
    const listingLocation =
        "<%= listing.location %>, <%= listing.country %>";


    // Create map
    const map = L.map("map").setView(
        [20.5937, 78.9629],
        5
    );


    // OpenStreetMap tiles
    L.tileLayer(
        "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
        {
            attribution:
                '&copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a> contributors'
        }
    ).addTo(map);


    // Convert location name into latitude and longitude
    fetch(
        "https://nominatim.openstreetmap.org/search?format=json&q="
        + encodeURIComponent(listingLocation)
    )
    .then(response => response.json())
    .then(data => {

        if (data.length > 0) {

            const latitude = parseFloat(data[0].lat);
            const longitude = parseFloat(data[0].lon);


            // Move map to listing location
            map.setView(
                [latitude, longitude],
                13
            );


            // Add marker
            L.marker([
                latitude,
                longitude
            ])
            .addTo(map)
            .bindPopup(
                "<b><%= listing.title %></b><br>" +
                "<%= listing.location %>, <%= listing.country %>"
            )
            .openPopup();


        } else {

            console.log(
                "Location not found:",
                listingLocation
            );

        }

    })
    .catch(error => {

        console.log(
            "Map location error:",
            error
        );

    });

</script>
